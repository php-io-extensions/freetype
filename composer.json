{
    "name": "php-io-extensions/freetype",
    "type": "php-ext",
    "description": "1:1 PHP bindings of FreeType 2: faces, sizes, SFNT tables, glyph loading and rendering",
    "keywords": [
        "freetype",
        "font",
        "glyph",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "system": {
                "apt": {
                    "depends": [
                        "libfreetype6"
                    ]
                },
                "brew": {
                    "build": [
                        "freetype"
                    ]
                }
            }
        }
    },
    "php-ext": {
        "extension-name": "freetype",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-freetype",
                "description": "Enable the freetype extension",
                "needs-value": false
            }
        ]
    }
}
